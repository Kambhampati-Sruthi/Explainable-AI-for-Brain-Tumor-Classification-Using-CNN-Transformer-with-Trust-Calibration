# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/

# Virtual environment & Environment variables
.venv/
venv/
ENV/
.env

# Raw data and temporary numpy arrays
data/raw/
data/cache/
*.npy
*.zip

# Logs
outputs/logs/
*.log

# Explicitly UNIGNORE PyTorch model files (so Git tracks them)
!*.pt
!*.pth
!models/*.pt
!models/deploy/*.pt